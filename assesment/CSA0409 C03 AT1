  #include <stdio.h>

  int main() {
    int pages, size, page, offset, frame, physical;
    int page_table[100];

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page size: ");
    scanf("%d", &size);

    printf("\nEnter frame number for each page:\n");

    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &page_table[i]);
    }

    printf("\nEnter logical page number: ");
    scanf("%d", &page);

    printf("Enter offset: ");
    scanf("%d", &offset);

    if (page >= pages || offset >= size || page < 0 || offset < 0) {
        printf("\nInvalid Logical Address\n");
    } else {
        frame = page_table[page];
        physical = frame * size + offset;

        printf("\nPage Number  = %d", page);
        printf("\nFrame Number = %d", frame);
        printf("\nOffset       = %d", offset);
        printf("\nPhysical Address = %d\n", physical);
    }

    return 0;
}
