  #include <stdio.h>

  int main() {
    float memory, tlb, hit, with_tlb, without_tlb;

    printf("Enter Memory Access Time (ns): ");
    scanf("%f", &memory);

    printf("Enter TLB Access Time (ns): ");
    scanf("%f", &tlb);

    printf("Enter TLB Hit Ratio (0 to 1): ");
    scanf("%f", &hit);

    without_tlb = 2 * memory;

    with_tlb = hit * (tlb + memory) +
               (1 - hit) * (tlb + 2 * memory);

    printf("\nWithout TLB = %.2f ns", without_tlb);
    printf("\nWith TLB = %.2f ns", with_tlb);

    if (with_tlb < without_tlb)
        printf("\nTLB improves memory access time.\n");
    else
        printf("\nTLB does not improve memory access time.\n");

    return 0;
}
