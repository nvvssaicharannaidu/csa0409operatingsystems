    int main() {
    int pages, page_size, page, offset;
    int frame[100], physical;

    printf("Enter number of pages: ");
    scanf("%d", &pages);

    printf("Enter page size: ");
    scanf("%d", &page_size);

    printf("\nEnter frame number for each page:\n");

    for (int i = 0; i < pages; i++) {
        printf("Page %d -> Frame: ", i);
        scanf("%d", &frame[i]);
    }

    printf("\nEnter page number: ");
    scanf("%d", &page);

    printf("Enter offset: ");
    scanf("%d", &offset);

    if (page < 0 || page >= pages || offset < 0 || offset >= page_size) {
        printf("\nInvalid Page Number or Offset\n");
    } else {
        physical = frame[page] * page_size + offset;

        printf("\nPage Number = %d", page);
        printf("\nFrame Number = %d", frame[page]);
        printf("\nPhysical Address = %d\n", physical);
    }

    return 0;
}
