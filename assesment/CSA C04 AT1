# ---------- Q1: File Allocation ----------
def contiguous(disk, size):
    n = len(disk)
    for s in range(n - size + 1):
        if all(disk[s:s+size][i] == 0 for i in range(size)):
            for i in range(s, s+size): disk[i] = 1
            return list(range(s, s+size))
    return None

def linked(disk, size):
    free = [i for i, b in enumerate(disk) if b == 0]
    if len(free) < size: return None
    for i in free[:size]: disk[i] = 1
    return free[:size]

def indexed(disk, size):
    free = [i for i, b in enumerate(disk) if b == 0]
    if len(free) < size + 1: return None
    idx, data = free[0], free[1:size+1]
    for i in [idx] + data: disk[i] = 1
    return idx, data

def q1():
    n = int(input("Disk size: "))
    size = int(input("File size: "))
    m = int(input("Method (1-Contiguous 2-Linked 3-Indexed): "))
    disk = [0]*n
    if m == 1: r = contiguous(disk, size); print("Allocated:", r or "Failed")
    elif m == 2: r = linked(disk, size); print("Allocated:", r or "Failed")
    elif m == 3:
        r = indexed(disk, size)
        print("Index block + Data blocks:", r if r else "Failed")
    print("Bitmap:", "".join(map(str, disk)))


# ---------- Q2: Bitmap Free Space Management ----------
def q2():
    n = int(input("Total blocks: "))
    bmp = [0]*n
    print("Bitmap:", "".join(map(str, bmp)))
    req = int(input("Blocks to allocate: "))
    free = [i for i, b in enumerate(bmp) if b == 0]
    if len(free) < req:
        print("Allocation failed")
    else:
        for i in free[:req]: bmp[i] = 1
        print("Allocated:", free[:req])
